# Application
NODE_ENV=development
APP_NAME=LifeTrack
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=generate-a-unique-32-character-or-longer-secret

# PostgreSQL (used by Docker Compose)
POSTGRES_DB=lifetrack
POSTGRES_USER=lifetrack
POSTGRES_PASSWORD=replace-with-a-unique-local-development-password

# Used by host-side Prisma commands. Docker Compose overrides the hostname to `db`.
DATABASE_URL=postgresql://lifetrack:replace-with-a-unique-local-development-password@localhost:5432/lifetrack?schema=public
